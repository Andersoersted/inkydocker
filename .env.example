# InkyDocker Environment Configuration Example
# Copy this file to .env and update with your actual values

# CRITICAL: Generate a strong secret key for production
# You can generate one using: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-generated-secret-key-here

# Database Configuration
# DATABASE_URL=sqlite:////app/data/mydb.sqlite

# Redis Configuration
# REDIS_URL=redis://localhost:6379/0

# Timezone
# TZ=Europe/Copenhagen

# Session Cookie Security (set to True in production with HTTPS)
# SESSION_COOKIE_SECURE=True
